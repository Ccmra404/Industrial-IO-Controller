**/backup/
**/backups/
**/cache/
**/temp/
**/tmp/

# Firmware build output directories
/firmware/build/
/firmware/out/
/firmware/Debug/
/firmware/Release/
/firmware/Objects/
/firmware/Listings/

# Common compiler intermediates
*.o
*.a
*.d
*.elf
*.map
*.lst

# Python tooling
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment and secrets
.env
.env.*
!.env.example
